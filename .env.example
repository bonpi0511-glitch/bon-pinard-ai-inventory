OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1

# Section 10 (admin-only initial inventory import) - server-only secrets.
# Never prefix these with NEXT_PUBLIC_, never import them into inventory-app.tsx.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=

# Section 12/13 (customer user invite + password setup) - the app's own
# public base URL (no trailing slash), e.g. https://your-app.example.com
# or http://localhost:3000 for local dev. Used to build the redirectTo for
# Supabase's invite email: `${NEXT_PUBLIC_APP_URL}/auth/setup-password`.
# Not a secret; safe to be NEXT_PUBLIC_. If unset, the invite falls back to
# the Site URL configured in the Supabase Dashboard (Auth > URL
# Configuration), and that Site URL's own onboarding page (if any) is used
# instead of this app's /auth/setup-password.
NEXT_PUBLIC_APP_URL=
